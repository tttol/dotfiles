{
  "description": "Review user prompts for natural English after each Codex turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B ~/.codex/hooks/english_review.py",
            "statusMessage": "Saving prompt for English review"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B ~/.codex/hooks/english_review.py",
            "timeout": 120,
            "statusMessage": "Reviewing prompt English"
          }
        ]
      }
    ]
  }
}
