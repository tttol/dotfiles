{
  "description": "Review user prompts for natural English when they are submitted.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B ~/.codex/hooks/english_review.py",
            "async": true,
            "timeout": 120,
            "statusMessage": "Reviewing prompt English"
          }
        ]
      }
    ]
  }
}
